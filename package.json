{
  "name": "no-boiler-zustand",
  "version": "0.3.0",
  "description": "Vite-only build-time helpers that make Zustand stores more concise and observable.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanKobtsev/better-zustand.git"
  },
  "homepage": "https://github.com/IvanKobtsev/better-zustand#readme",
  "bugs": {
    "url": "https://github.com/IvanKobtsev/better-zustand/issues"
  },
  "keywords": ["zustand", "vite", "selectors", "redux-devtools", "typescript"],
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:package",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run verify"
  },
  "dependencies": {
    "@babel/core": "^7.28.0"
  },
  "peerDependencies": {
    "vite": ">=5 <8",
    "zustand": ">=5 <6"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
